rules_version = '2';

// OBD Cube - Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣으세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 최초 관리자 부트스트랩 이메일.
    // 이 이메일로 로그인하면 앱이 자동으로 admins/{uid} 문서를 만들어 관리자 권한을 부여합니다.
    function isBootstrapAdminEmail() {
      return isSignedIn() && request.auth.token.email == "sycovy0706@naver.com";
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 전체 공지 등 사이트 전역 설정 - 관리자만 작성 가능, 누구나 열람 가능
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 사용자 프로필 (닉네임 등)
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // 닉네임 중복 확인용 색인 문서 (nicknames/{nickname} = { uid })
    // 회원가입 과정에서 로그인 전에 중복 확인이 필요하므로 읽기는 비로그인 상태에서도 허용합니다.
    // (uid 외의 민감 정보는 들어있지 않습니다)
    match /nicknames/{nickname} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // 관리자 목록
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
                        (request.auth.uid == uid && isBootstrapAdminEmail()) ||
                        isAdmin()
                      );
      allow delete: if isAdmin();
      allow update: if false;
    }

    // 심심풀이 - 틱택토 온라인 대전 방
    // 문서 구조: { board:[9칸], turn:'X'|'O', status:'waiting'|'playing'|'finished',
    //             playerX:{uid,nickname}, playerO:{uid,nickname}|null, winner:'X'|'O'|'draw'|null }
    match /tictactoeGames/{roomId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
                        request.resource.data.playerX.uid == request.auth.uid &&
                        request.resource.data.playerO == null &&
                        request.resource.data.status == 'waiting' &&
                        request.resource.data.turn == 'X' &&
                        request.resource.data.board.size() == 9;

      allow update: if isSignedIn() && (
                        // 참가(O로 합류)
                        (resource.data.status == 'waiting' &&
                         resource.data.playerO == null &&
                         request.resource.data.playerO.uid == request.auth.uid &&
                         request.resource.data.playerX.uid == resource.data.playerX.uid &&
                         request.resource.data.board == resource.data.board &&
                         request.resource.data.status == 'playing') ||
                        // 턴에 따른 착수 (승리/무승부로 인한 종료 포함)
                        (resource.data.status == 'playing' &&
                         ((resource.data.turn == 'X' && resource.data.playerX.uid == request.auth.uid) ||
                          (resource.data.turn == 'O' && resource.data.playerO.uid == request.auth.uid)) &&
                         request.resource.data.playerX.uid == resource.data.playerX.uid &&
                         request.resource.data.playerO.uid == resource.data.playerO.uid &&
                         request.resource.data.turn != resource.data.turn) ||
                        // 나가기(기권)
                        (resource.data.status != 'finished' &&
                         (resource.data.playerX.uid == request.auth.uid ||
                          (resource.data.playerO != null && resource.data.playerO.uid == request.auth.uid)) &&
                         request.resource.data.status == 'finished')
                      );

      allow delete: if isSignedIn() && resource.data.playerX.uid == request.auth.uid;
    }

    // 대회 주최 신청
    match /applications/{appId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                        request.resource.data.applicantUid == request.auth.uid &&
                        request.resource.data.status == 'pending';
      // 관리자는 승인/반려 가능. 신청자 본인은 반려된 신청을 취소만 가능.
      allow update: if isSignedIn() && (
                        isAdmin() ||
                        (resource.data.applicantUid == request.auth.uid &&
                         resource.data.status == 'pending' &&
                         request.resource.data.status == 'cancelled')
                      );
      // 관리자, 또는 본인 신청 건은 신청자 스스로도 삭제 가능
      // (대회 삭제 시 연결된 신청 기록도 함께 정리하기 위함)
      allow delete: if isAdmin() || (isSignedIn() && resource.data.applicantUid == request.auth.uid);
    }

    // 승인된 대회
    match /competitions/{compId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn() && (isAdmin() || isCompOrganizer(resource.data));
      allow delete: if isSignedIn() && (isAdmin() || isCompOrganizer(resource.data));

      // 대회 데이터(data)를 받아 주최자 본인 또는 공동 주최자인지 확인
      function isCompOrganizer(compData) {
        return isSignedIn() &&
          (compData.organizerUid == request.auth.uid ||
           (compData.coOrganizerUids != null && request.auth.uid in compData.coOrganizerUids));
      }

      function isOrganizer() {
        return isCompOrganizer(get(/databases/$(database)/documents/competitions/$(compId)).data);
      }

      // 스태프: 종목/스크램블 관리는 가능하지만 그 외 주최자 권한은 없는 보조 역할
      function isCompStaff(compData) {
        return isSignedIn() &&
          compData.staffUids != null && request.auth.uid in compData.staffUids;
      }

      function isStaff() {
        return isCompStaff(get(/databases/$(database)/documents/competitions/$(compId)).data);
      }

      // 종목 추가 신청 - 누구나 신청 가능, 주최자/스태프/관리자가 승인하면 실제 종목(events)이 생성됨
      match /eventRequests/{requestId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
                          request.resource.data.requesterUid == request.auth.uid &&
                          request.resource.data.status == 'pending';
        allow update: if isSignedIn() && (isAdmin() || isOrganizer() || isStaff());
        allow delete: if isSignedIn() && (
                          isAdmin() || isOrganizer() || isStaff() ||
                          resource.data.requesterUid == request.auth.uid
                        );
      }

      // 주최팀(주최자·공동 주최자·스태프) 전용 대화방 - 참가자는 열람 불가
      match /teamChat/{messageId} {
        allow read: if isSignedIn() && (isAdmin() || isOrganizer() || isStaff());
        allow create: if isSignedIn() && (isAdmin() || isOrganizer() || isStaff()) &&
                          request.resource.data.senderUid == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && (
                          isAdmin() || isOrganizer() ||
                          resource.data.senderUid == request.auth.uid
                        );
      }

      // 대회별 공지 - 주최자/공동 주최자/스태프 누구나 작성 가능, 참가자 포함 누구나 열람 가능
      match /announcement/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isAdmin() || isOrganizer() || isStaff());
      }

      // 종목 (Events)
      match /events/{eventId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isAdmin() || isOrganizer() || isStaff());

        // 스크램블
        match /scrambles/{scrambleId} {
          allow read: if isSignedIn() && (
                          resource.data.isPublic == true ||
                          isAdmin() ||
                          isOrganizer() ||
                          isStaff()
                        );
          allow write: if isSignedIn() && (isAdmin() || isOrganizer() || isStaff());
        }

        // 대회가 종료(ended)되면 더 이상 기록을 등록/수정할 수 없음
        function isCompActive() {
          return get(/databases/$(database)/documents/competitions/$(compId)).data.status != 'ended';
        }

        // 참가자 문서 구조: { nickname, uid, roundTimes: {N: [...]}, roundMeta: {N: {status, rank}} }
        // 기록(시간)은 roundTimes, 진출/탈락·순위는 roundMeta에 분리 저장한다.
        //
        // 참가자 (라운드별 기록/진출·탈락 여부)
        // - 열람: 로그인한 누구나 (대회 페이지에서 순위·라운드 진출 현황을 볼 수 있어야 함)
        // - 등록(참가 신청): 본인 uid로 스스로 가능
        // - 수정: 주최자/관리자는 항상 전체 수정 가능.
        //   본인은 대회가 종료되지 않았을 때 roundTimes(기록)만 수정 가능하고,
        //   roundMeta(순위·진출/탈락)는 절대 건드릴 수 없음 - 새 문서와 값이 같아야 함.
        match /participants/{participantId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && (
                            isAdmin() || isOrganizer() ||
                            request.resource.data.uid == request.auth.uid
                          );
          allow update: if isSignedIn() && (
                            isAdmin() || isOrganizer() ||
                            (resource.data.uid == request.auth.uid &&
                             isCompActive() &&
                             request.resource.data.roundMeta == resource.data.roundMeta)
                          );
          allow delete: if isSignedIn() && (isAdmin() || isOrganizer() || resource.data.uid == request.auth.uid);
        }

        // 참가자 명단 (공개 열람용, 기록/순위는 포함하지 않음) - 문서 id = 본인 uid.
        // 이미 신청한 사람이 다시 신청하면 문서가 이미 있어 update로 취급되고,
        // update는 아무도 허용하지 않으므로 중복 신청이 자동으로 막힘.
        match /roster/{uid} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.auth.uid == uid;
          allow update: if false;
          allow delete: if isSignedIn() && (isAdmin() || isOrganizer() || request.auth.uid == uid);
        }
      }
    }
  }
}
